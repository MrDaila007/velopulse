# Copy to .env or run `make env` to discover and write local paths.
# Values exported by the calling shell override this file.
ZEPHYR_BASE=/path/to/zephyrproject/zephyr
ZEPHYR_SDK_INSTALL_DIR=/path/to/zephyr-sdk-1.0.0
WEST_TOP=/path/to/zephyrproject
WEST_BIN=/path/to/zephyrproject/.venv/bin/west
ZEPHYR_PYTHON=/path/to/zephyrproject/.venv/bin/python
U8G2_ROOT=/path/to/u8g2
USER_CACHE_DIR=/path/to/cache/zephyr
CCACHE_DIR=/path/to/cache/ccache
CCACHE_TEMPDIR=/path/to/cache/ccache/tmp
